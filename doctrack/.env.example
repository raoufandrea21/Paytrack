# Copy this file to .env.local and drop your key in.
#
#   cp .env.example .env.local
#
# The key is read by the server side of the app only — the Vite dev middleware
# in vite.config.js and the serverless function in api/extract.js. It is NOT
# prefixed with VITE_, so Vite will never inline it into the browser bundle.
#
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Set to 1 to serve over HTTPS (npm run dev:https does this for you). You need
# this to install the app on a phone that reaches your laptop over the LAN,
# because Chrome only registers a service worker on a secure origin.
# DOCTRACK_HTTPS=1

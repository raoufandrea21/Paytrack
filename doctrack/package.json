{
  "name": "doctrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first PWA for tracking family document expiries",
  "scripts": {
    "dev": "vite",
    "dev:https": "cross-env DOCTRACK_HTTPS=1 vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test test/*.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prebuild": "node scripts/vendor-ocr.mjs",
    "postinstall": "node scripts/vendor-ocr.mjs",
    "vendor:ocr": "node scripts/vendor-ocr.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
